#!/bin/sh
# Enable nftables FullCone NAT globally and on every masquerading firewall zone.
# This is applied once on first boot after the default firewall configuration exists.

DEFAULTS="$(uci -q show firewall | sed -n 's/^\(firewall\.[^=]*\)=defaults$/\1/p' | head -n 1)"
if [ -z "$DEFAULTS" ]; then
    DEFAULTS="$(uci add firewall defaults)"
fi
uci -q set "$DEFAULTS.fullcone=1"

uci -q show firewall | while IFS= read -r line; do
    case "$line" in
        firewall.*=zone)
            section="${line%%=*}"
            masquerade="$(uci -q get "$section.masq")"
            if [ "$masquerade" = "1" ]; then
                uci -q set "$section.fullcone=1"
            fi
            ;;
    esac
done

uci -q commit firewall
exit 0

# NN6000 V2 - upstream-like minimal profile
# Keep the original VIKINGYFY target defaults, board drivers and NSS packages.
# Only add the native nftables firewall profile, standard LuCI and network tuning.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_link_nn6000-v2="ipq-wifi-link_nn6000"
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# Build options
CONFIG_USE_APK=n
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# Original LuCI collection
CONFIG_PACKAGE_luci=y

# Do not include Docker management or its local engine dependencies.
# CONFIG_PACKAGE_luci-app-dockerman is not set

CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_nftables-json=y
# firewall4 selects its required nftables kernel modules through package dependencies.
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-bridge=y

# Basic network performance / diagnostics
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tls=y

# Optional applications, storage tools, USB adapters and service plugins are
# intentionally not selected here; install them later from LuCI or opkg/apk.
# The target's own DEFAULT_PACKAGES, NSS, Wi-Fi and board-specific drivers remain.

# NN6000 V2 - 实用精简配置
# 保留设备目标、设备专用 Wi-Fi 包；硬件驱动与 NSS 核心配置由目标配置及 nss.config 提供。
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_link_nn6000-v2="ipq-wifi-link_nn6000"
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# Build options (not runtime services)
CONFIG_USE_APK=n
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# Keep existing system defaults and Autocore (NN6000 temperature/status display)
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_autocore=y

# Optional services intentionally not built in:
# PassWall, OpenClash, Docker/Dockerman, AdGuardHome, EasyTier.
# QuickFile and Nginx are installed by nn6000v2/scripts/packages.sh.
# DHCP, static leases, LuCI, firewall, Ethernet/switch, Wi-Fi and platform
# drivers remain provided by the upstream NN6000 V2 target defaults.

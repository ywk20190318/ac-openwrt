# NN6000 V2 - upstream-like minimal profile
# Keep the original VIKINGYFY target defaults, board drivers and NSS packages.
# Only add the native nftables firewall profile, standard LuCI and network tuning.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_link_nn6000-v2="ipq-wifi-link_nn6000"
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# Build options
CONFIG_USE_APK=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# Original LuCI collection + Simplified Chinese translation.
# LuCI generates luci-i18n-* hidden packages from this language selection.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_LUCI_LANG_zh_Hans=y

# QuickFile requires the upstream luci-nginx collection and its Nginx reverse proxy.
CONFIG_PACKAGE_luci-nginx=y
CONFIG_PACKAGE_luci-app-quickfile=y
CONFIG_PACKAGE_quickfile=y
CONFIG_PACKAGE_nginx-ssl=y
CONFIG_PACKAGE_nginx-util=y
CONFIG_PACKAGE_nginx-mod-luci=y
CONFIG_PACKAGE_nginx-mod-ubus=y
CONFIG_PACKAGE_uwsgi=y
CONFIG_PACKAGE_uwsgi-luci-support=y

# USB mass storage and common external-disk filesystems.
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_fuse-utils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_resize2fs=y

# Docker/Dockerman/Podman remain excluded.
# CONFIG_PACKAGE_luci-app-dockerman is not set

CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_nftables-json=y
# OpenClash runtime requirements (must match this firmware's kernel ABI).
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
# firewall4 selects its required nftables kernel modules through package dependencies.
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-bridge=y

# Basic network performance / diagnostics
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tls=y

# Optional applications, storage tools, USB adapters and service plugins are
# intentionally not selected here; install them later from configured APK repositories.
# The target's own DEFAULT_PACKAGES, NSS, Wi-Fi and board-specific drivers remain.

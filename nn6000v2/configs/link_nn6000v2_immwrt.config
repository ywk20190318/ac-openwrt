CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_link_nn6000-v2="ipq-wifi-link_nn6000"
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# TARGET config
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# NSS Firmware Configuration
CONFIG_FEED_nss_packages=n
CONFIG_FEED_sqm_scripts_nss=n
CONFIG_NSS_FIRMWARE_VERSION_12_5=y

# WiFi Drivers and Firmware
CONFIG_PACKAGE_kmod-ath=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=y
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=y

# Compile
CONFIG_USE_APK=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# BUSYBOX
CONFIG_BUSYBOX_CUSTOM=y

# Proto
CONFIG_PACKAGE_luci-nginx=y
CONFIG_PACKAGE_nginx-ssl=y
# CONFIG_PACKAGE_luci-light is not set
# CONFIG_PACKAGE_uhttpd is not set
# CONFIG_PACKAGE_uhttpd-mod-lua is not set
# CONFIG_PACKAGE_uhttpd-mod-ubus is not set
# CONFIG_PACKAGE_uhttpd-mod-ucode is not set
CONFIG_PACKAGE_luci-proto-relay=m

# Libraries
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-conf=y

# Disable Package
CONFIG_PACKAGE_automount=n
CONFIG_PACKAGE_dnsmasq=n

# DNS
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y

# DEFAULT SET
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

# nftables kernel modules
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-offload=m
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_fullconenat-sonic=y
CONFIG_PACKAGE_luci-app-fullconenat-sonic=y
CONFIG_PACKAGE_kmod-nft-bridge=m
CONFIG_PACKAGE_kmod-nft-queue=m
CONFIG_PACKAGE_kmod-nft-netdev=m

# IPv6 protocol stack and base firewall/NAT modules
CONFIG_IPV6=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-nf-log6=y
CONFIG_PACKAGE_kmod-nf-reject6=y

# Optional IPv6 firewall, routing and tunnel modules (built as ABI-matched APKs)
CONFIG_PACKAGE_kmod-nf-ipt6=m
CONFIG_PACKAGE_kmod-ip6tables=m
CONFIG_PACKAGE_kmod-ip6tables-extra=m
CONFIG_PACKAGE_kmod-ip6-tunnel=m
CONFIG_PACKAGE_kmod-sit=m
CONFIG_PACKAGE_kmod-gre=m
CONFIG_PACKAGE_kmod-gre6=m
CONFIG_PACKAGE_kmod-fou=m
CONFIG_PACKAGE_kmod-fou6=m
CONFIG_PACKAGE_kmod-ipsec6=m
CONFIG_PACKAGE_kmod-ip6-vti=m
CONFIG_PACKAGE_kmod-xfrm-interface=m

# Additional network modules
CONFIG_PACKAGE_kmod-tcp-bbr=m
CONFIG_PACKAGE_kmod-veth=m
CONFIG_PACKAGE_kmod-bonding=m
CONFIG_PACKAGE_kmod-dsa=m
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# Essential filesystem modules stay in the image; optional filesystems are standalone APKs
# Kernel modules
CONFIG_PACKAGE_kmod-fs-exfat=m
CONFIG_PACKAGE_kmod-fs-vfat=m
CONFIG_PACKAGE_kmod-fs-ext4=m
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=m
CONFIG_PACKAGE_kmod-fs-cifs=m
CONFIG_PACKAGE_kmod-fs-nfs=m
CONFIG_PACKAGE_kmod-fs-squashfs=y
CONFIG_PACKAGE_kmod-fs-overlay=y
CONFIG_PACKAGE_kmod-netlink-diag=m
CONFIG_PACKAGE_kmod-inet-diag=m
CONFIG_PACKAGE_kmod-tls=m
CONFIG_PACKAGE_kmod-tun=m

# Optional USB host/peripheral/network drivers are standalone ABI-matched APKs
#  USB Support
CONFIG_PACKAGE_kmod-usb-acm=m
CONFIG_PACKAGE_kmod-usb-ehci=m
CONFIG_PACKAGE_kmod-usb-ohci=m
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=m
CONFIG_PACKAGE_kmod-usb-serial-option=m
CONFIG_PACKAGE_kmod-usb-serial-wwan=m
CONFIG_PACKAGE_kmod-usb-storage=m
CONFIG_PACKAGE_kmod-usb-storage-extras=m
CONFIG_PACKAGE_kmod-usb-storage-uas=m
CONFIG_PACKAGE_kmod-usb2=m
CONFIG_PACKAGE_kmod-usb3=m
CONFIG_PACKAGE_kmod-usb-dwc3=m
CONFIG_PACKAGE_kmod-usb-xhci-hcd=m
CONFIG_PACKAGE_kmod-usb-printer=m
CONFIG_PACKAGE_kmod-usb-net=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=m
CONFIG_PACKAGE_uqmi=m
CONFIG_PACKAGE_libqmi=m
CONFIG_PACKAGE_luci-proto-qmi=m
CONFIG_PACKAGE_umbim=m
CONFIG_PACKAGE_libmbim=m
CONFIG_PACKAGE_luci-proto-mbim=m
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=m
CONFIG_PACKAGE_kmod-usb-net-rndis=m
CONFIG_PACKAGE_kmod-usb-net-rtl8150=m
CONFIG_PACKAGE_kmod-usb-net-rtl8152=m
CONFIG_PACKAGE_kmod-usb-net-asix=m
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=m
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=m
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=m
CONFIG_PACKAGE_kmod-usb-net-ipheth=m
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=m
CONFIG_PACKAGE_usb-modeswitch=m

# Optional command-line utilities are standalone APKs
# Package
CONFIG_PACKAGE_rng-tools=m
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_blkid=m
CONFIG_PACKAGE_htop=m
CONFIG_PACKAGE_fuse-utils=m
CONFIG_PACKAGE_ntfs3-mount=m
CONFIG_PACKAGE_openssh-sftp-server=m
CONFIG_PACKAGE_tcpdump=m
CONFIG_PACKAGE_curl=m
CONFIG_PACKAGE_wget=m
CONFIG_PACKAGE_mtr=m
CONFIG_PACKAGE_socat=m
CONFIG_PACKAGE_iperf3=m
CONFIG_PACKAGE_ethtool=m
CONFIG_PACKAGE_sgdisk=m
CONFIG_PACKAGE_openssl-util=m
CONFIG_PACKAGE_resize2fs=m
CONFIG_PACKAGE_qrencode=m
CONFIG_PACKAGE_smartmontools-drivedb=m
CONFIG_PACKAGE_usbutils=m
CONFIG_PACKAGE_xz-utils=m
CONFIG_PACKAGE_bash=m
CONFIG_PACKAGE_ipset=m

# WireGuard VPN
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=m

# Optional LuCI applications (built as standalone APKs; not installed in the image)
CONFIG_PACKAGE_luci-app-quickfile=m
CONFIG_PACKAGE_luci-app-mini-diskmanager=m
CONFIG_PACKAGE_luci-app-hd-idle=m
CONFIG_PACKAGE_luci-app-p910nd=m
CONFIG_PACKAGE_luci-theme-argon=m
CONFIG_PACKAGE_luci-app-argon-config=m
